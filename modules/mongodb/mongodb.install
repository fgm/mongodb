<?php

/**
 * @file
 * Install file for the MongoDB module.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\mongodb\Hook\MongodbRequirements;

/**
 * Implements hook_requirements().
 *
 * Drupal 11.3 and later skip it, running MongodbRequirements instead.
 *
 * @return array<string,array<string,mixed>>
 *   The requirements.
 *
 * @todo Remove when dropping Drupal 10 support.
 *   https://www.drupal.org/project/mongodb/issues/3626729
 */
#[LegacyRequirementsHook]
function mongodb_requirements(string $phase): array {
  if ($phase === 'install') {
    // The module is not installed yet, so its classes are not autoloadable.
    require_once __DIR__ . '/src/Install/Severity.php';
    require_once __DIR__ . '/src/Hook/MongodbRequirements.php';
  }
  return MongodbRequirements::check();
}
